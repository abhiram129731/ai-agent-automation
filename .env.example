# Required: powers the web-discovery stage (free key: aistudio.google.com/apikey)
GEMINI_API_KEY=your_gemini_api_key_here

# Optional: override the Gemini model used for discovery (default: gemini-3.6-flash)
GEMINI_MODEL=gemini-3.6-flash

# Optional: improves email coverage/verification (Hunter.io free tier: hunter.io)
HUNTER_API_KEY=your_hunter_key_here
